# ===== Credentials (required) =====
PISHGAMAN_USERNAME=
PISHGAMAN_PASSWORD=

# ===== Target =====
BASE_URL=https://my.pishgaman.net/panel/

# ===== Browser =====
# true = بدون پنجره مرورگر | false = مرورگر با پنجره باز می‌شود (برای دیباگ خوب است)
HEADLESS=true
NAV_TIMEOUT_MS=60000
SLOW_MO_MS=0
ACCEPT_INSECURE_CERTS=true
# مسیر دستی مرورگر — معمولاً لازم نیست؛ داخل Docker خودکار تنظیم می‌شود
# مثال: CHROME_PATH=/usr/bin/chromium
CHROME_PATH=

# ===== Login retries =====
MAX_LOGIN_RETRIES=5
RETRY_DELAY_MS=2000
# چقدر بعد از کلیک روی ورود، منتظر تشخیص موفقیت بمانیم (میلی‌ثانیه)
LOGIN_DETECT_MS=12000

# ===== Captcha OCR =====
# کاراکترهای مجاز کپچا — هرچه محدودتر باشد دقت بالاتر می‌رود
# اگر کپچا فقط عدد است: 0123456789
CAPTCHA_WHITELIST=0123456789ABCDEFGHJKLMNPQRSTUVWXYZ
CAPTCHA_MIN_LEN=3
CAPTCHA_MAX_LEN=10
# بزرگ‌نمایی تصویر کپچا قبل از OCR
CAPTCHA_SCALE=4
# آستانه سیاه/سفید کردن تصویر (0 تا 255)
CAPTCHA_THRESHOLD=140
CAPTCHA_OCR_LANG=eng
# 7 = تک‌خط متن (مناسب کپچا)
CAPTCHA_OCR_PSM=7
CAPTCHA_FORCE_UPPERCASE=false

# ===== Session =====
SESSION_FILE=sessions/session.json

# ===== OCR cache =====
# محل کش فایل زبان OCR (eng.traineddata). نقطه = کنار پروژه.
# داخل Docker خودکار روی ولیوم تنظیم می‌شود: /app/.tesseract-cache
TESSERACT_CACHE_PATH=.

# ===== Misc =====
# 1 = ذخیره تصاویر خام/پردازش‌شده کپچا در logs/ برای دیباگ
DEBUG=1
